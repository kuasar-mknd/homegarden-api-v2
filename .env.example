# Application
NODE_ENV=development
PORT=3000
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/homegarden

# Authentication (Supabase)
# Required for all authenticated endpoints
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-service-role-key # Optional, for admin tasks

# JWT (Fallback/Legacy)
# Only used if not using Supabase Auth
# JWT_SECRET=your-super-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# AI & Integrations
# Required for Plant ID and Dr. Plant features
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_IDENTIFICATION_MODEL=gemini-2.0-flash
GEMINI_DIAGNOSIS_MODEL=gemini-2.5-pro-preview-06-05

# PlantNet API (Fallback)
# PLANTNET_API_KEY=your-plantnet-key

# Weather API
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Storage
# STORAGE_BUCKET=homegarden-bucket

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=350
